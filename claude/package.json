    "eslint": "^10.5.0",
    "eslint-plugin-import-x": "^4.16.2"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/openai": "^3.0.73",
    "@anthropic-ai/claude-agent-sdk": "^0.3.185",
    "@anthropic-ai/sdk": "^0.105.0",
    "@octokit/rest": "^22.0.1",
    "@openrouter/sdk": "^0.13.7",
    "ai": "^6.0.208",
    "big.js": "^7.0.1",
    "dotenv": "^17.4.2",
    "openai": "^6.44.0",
    "zod": "^4.4.3"
  }
