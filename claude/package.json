{
  "name": "claude-config",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint scripts/",
    "lint:fix": "eslint scripts/ --fix",
    "test": "bun test",
    "commit": "bun run scripts/workflow/commit-and-push.ts",
    "pr": "bun run scripts/workflow/create-pull-request.ts",
    "release": "bun run scripts/workflow/create-release.ts",
    "publish-release": "bun run scripts/workflow/publish-release.ts",
    "hotfix": "bun run scripts/workflow/create-hotfix.ts",
    "publish-hotfix": "bun run scripts/workflow/publish-hotfix.ts",
    "feature": "bun run scripts/workflow/create-feature.ts",
