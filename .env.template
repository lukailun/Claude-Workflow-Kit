# ============================================================
# Claude Workflow Kit 环境变量模板
#
# 分为两层：
#   - 用户级（~/.dev-kit/.env）：个人凭据，跨项目共享
#   - 项目级（.dev-kit/.env）：项目配置，因项目而异
#
# 优先级：Shell export > 项目级 .dev-kit/.env > 用户级 ~/.dev-kit/.env
# ============================================================


# ============================================================
# 用户级（复制到 ~/.dev-kit/.env）
# 个人凭据，所有项目共享
# ============================================================

# ── 平台 Token ──
GITHUB_TOKEN=${GITHUB_TOKEN}
GITLAB_TOKEN=${GITLAB_TOKEN}
LINEAR_API_KEY=${LINEAR_API_KEY}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
SENTRY_API_KEY=${SENTRY_API_KEY}
FIGMA_TOKEN=${FIGMA_TOKEN}

# ── AI 服务 API Key ──
# 根据你使用的 AI 服务，添加对应的 key
# 未使用的服务可以删除或注释掉

# Anthropic
CLAUDE_API_KEY=${CLAUDE_API_KEY}
CLAUDE_AUTH_TOKEN=${CLAUDE_AUTH_TOKEN}

# DeepSeek
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}

# Gemini
GEMINI_API_KEY=${GEMINI_API_KEY}

# GLM
GLM_API_KEY=${GLM_API_KEY}

# Hy
HY_API_KEY=${HY_API_KEY}

# LongCat
LONGCAT_API_KEY=${LONGCAT_API_KEY}

# Mimo
MIMO_API_KEY=${MIMO_API_KEY}

# MiniMax
MINIMAX_API_KEY=${MINIMAX_API_KEY}

# Qwen
QWEN_API_KEY=${QWEN_API_KEY}


# ============================================================
# 项目级（复制到 .dev-kit/.env）
# 项目配置，因项目而异
# ============================================================

# ── GitLab ──
GITLAB_BASE_URL=https://git.mampod.work

# ── GitHub ──
GITHUB_BASE_URL=https://api.github.com

# ── Linear ──
LINEAR_PROJECT_ID=01f27b55-ba78-48b1-8dab-9708d71cd7bf

# ── OpenRouter ──
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Sentry ──
SENTRY_BASE_URL=https://sentry.mampod.work/
SENTRY_ORGANIZATION=4tune
SENTRY_PROJECT=gusto-english

# ── Figma ──
FIGMA_BASE_URL=https://api.figma.com
FIGMA_FILE_ID=${FIGMA_FILE_ID}
FIGMA_PAGE_ID=${FIGMA_PAGE_ID}

# ── AI 服务 Base URL ──
CLAUDE_BASE_URL=${CLAUDE_BASE_URL}
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GLM_BASE_URL=https://open.bigmodel.cn
HY_BASE_URL=https://tokenhub.tencentmaas.com
LONGCAT_BASE_URL=https://api.longcat.chat
MIMO_BASE_URL=https://api.xiaomimimo.com
MINIMAX_BASE_URL=https://api.minimaxi.com
QWEN_BASE_URL=https://dashscope.aliyuncs.com
