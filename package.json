{
  "name": "claude-workflow-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint packages/*/src/**/*.ts",
    "lint:fix": "eslint packages/*/src/**/*.ts --fix",
    "test": "turbo run test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",

    "feature": "pnpm --filter @cwkit/workflow feature",
    "feat": "pnpm --filter @cwkit/workflow feat",
    "experimental": "pnpm --filter @cwkit/workflow experimental",
    "exp": "pnpm --filter @cwkit/workflow exp",
    "commit": "pnpm --filter @cwkit/workflow commit",
    "mr": "pnpm --filter @cwkit/workflow mr",
    "submit": "pnpm --filter @cwkit/workflow submit",
    "hotfix": "pnpm --filter @cwkit/workflow hotfix",
    "publish-release": "pnpm --filter @cwkit/workflow publish-release",
    "publish-hotfix": "pnpm --filter @cwkit/workflow publish-hotfix",
    "receipt": "pnpm --filter @cwkit/workflow receipt",
    "yolo": "pnpm --filter @cwkit/workflow yolo"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  }
}
