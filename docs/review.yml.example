code-review:
  stage: test
  before_script: []
  script:
    - cd .claude && bun install --frozen-lockfile && cd ..
    - bun run .claude/scripts/review/run.ts
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_TITLE =~ /^Draft:/
      when: never
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  allow_failure: false
  tags:
    - shanghai
