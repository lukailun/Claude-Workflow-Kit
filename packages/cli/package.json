{
  "name": "@lukailun/dev-kit-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --build",
    "release": "bun run ../../packages/workflow/src/create-release.ts",
    "hotfix": "bun run ../../packages/workflow/src/create-hotfix.ts",
    "feature": "bun run ../../packages/workflow/src/create-feature.ts",
    "feat": "bun run ../../packages/workflow/src/create-feature.ts",
    "experimental": "bun run ../../packages/workflow/src/create-experimental.ts",
    "exp": "bun run ../../packages/workflow/src/create-experimental.ts",
    "commit": "bun run ../../packages/workflow/src/commit-and-push.ts",
    "mr": "bun run ../../packages/workflow/src/create-merge-request.ts",
    "submit": "bun run ../../packages/workflow/src/submit.ts",
    "publish-hotfix": "bun run ../../packages/workflow/src/publish-hotfix.ts",
    "publish-release": "bun run ../../packages/workflow/src/publish-release.ts",
    "receipt": "bun run ../../packages/workflow/src/build-branch-receipt.ts",
    "yolo": "bun run ../../packages/workflow/src/yolo.ts",
    "create-rule": "bun run ../../packages/review/src/create-rule.ts"
  },
  "dependencies": {
    "@lukailun/dev-kit-workflow": "workspace:*",
    "@lukailun/dev-kit-review": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "catalog:",
    "typescript": "catalog:"
  }
}
