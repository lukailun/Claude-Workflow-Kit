{
  "name": "@cwkit/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "cwkit": "./bin/cwkit.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@cwkit/ai": "workspace:*",
    "@cwkit/shared": "workspace:*",
    "@cwkit/workflow": "workspace:*",
    "@cwkit/gitlab": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
