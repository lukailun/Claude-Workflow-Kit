{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src", "outDir": "dist",
    "composite": true, "noEmit": false, "emitDeclarationOnly": true,
    "resolveJsonModule": true, "isolatedModules": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts"], "exclude": ["node_modules"],
  "references": [
    { "path": "../core" }, { "path": "../gitlab" }, { "path": "../linear" },
    { "path": "../openrouter" }, { "path": "../language-models" },
    { "path": "../claudecode" }, { "path": "../codex" }
  ]
}
